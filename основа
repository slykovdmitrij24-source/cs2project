<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CS:GO Case Battle Simulator</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0a0e1a, #1a1f2f);
            min-height: 100vh;
            color: white;
        }

        /* Навигация */
        .navbar {
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid rgba(255, 215, 0, 0.3);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #ffd700;
            text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
        }

        .balance {
            background: rgba(0, 0, 0, 0.5);
            padding: 10px 25px;
            border-radius: 30px;
            border: 1px solid #ffd700;
            font-size: 20px;
        }

        #balanceAmount {
            color: #4caf50;
            font-weight: bold;
            margin-left: 10px;
        }

        .nav-buttons {
            display: flex;
            gap: 15px;
        }

        .nav-btn {
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: white;
            padding: 10px 25px;
            border-radius: 25px;
            cursor: pointer;
            font-size: 16px;
            transition: all 0.3s;
            border: 1px solid transparent;
        }

        .nav-btn:hover {
            background: rgba(255, 215, 0, 0.2);
            border-color: #ffd700;
        }

        .nav-btn.active {
            background: #ffd700;
            color: #1a1f2f;
            font-weight: bold;
        }

        /* Основной контейнер */
        .container {
            max-width: 1400px;
            margin: 30px auto;
            padding: 0 20px;
        }

        /* Страницы */
        .page {
            display: none;
        }

        .page.active-page {
            display: block;
        }

        /* Кейсы */
        .cases-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            margin-top: 30px;
        }

        .case-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            border: 2px solid transparent;
            position: relative;
            overflow: hidden;
        }

        .case-card:hover {
            transform: translateY(-10px);
            border-color: #ffd700;
            background: rgba(255, 255, 255, 0.1);
        }

        .case-card.selected {
            border-color: #ffd700;
            background: rgba(255, 215, 0, 0.1);
        }

        .case-icon {
            font-size: 80px;
            margin-bottom: 15px;
            filter: drop-shadow(0 0 20px rgba(255, 215, 0, 0.5));
        }

        .case-name {
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .case-price {
            color: #ffd700;
            font-size: 18px;
            margin-bottom: 15px;
        }

        .case-items {
            color: #888;
            font-size: 14px;
        }

        /* Результат открытия */
        .result-area {
            background: rgba(0, 0, 0, 0.5);
            border-radius: 20px;
            padding: 30px;
            margin: 30px 0;
            text-align: center;
            border: 2px solid rgba(255, 215, 0, 0.3);
            min-height: 150px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .item-display {
            animation: itemAppear 0.5s ease;
        }

        @keyframes itemAppear {
            0% { transform: scale(0); opacity: 0; }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); opacity: 1; }
        }

        .item-name {
            font-size: 36px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .item-price {
            font-size: 24px;
        }

        .item-quality {
            font-size: 18px;
            opacity: 0.8;
        }

        /* Инвентарь */
        .inventory-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 30px;
            max-height: 600px;
            overflow-y: auto;
            padding: 10px;
        }

        .inventory-item {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            border: 2px solid transparent;
            position: relative;
        }

        .inventory-item:hover {
            transform: translateY(-5px);
            border-color: currentColor;
            background: rgba(255, 255, 255, 0.1);
        }

        .inventory-item.selected {
            border-color: #ffd700;
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.3);
        }

        .inventory-icon {
            font-size: 40px;
            margin-bottom: 10px;
        }

        .inventory-name {
            font-weight: bold;
            margin-bottom: 5px;
            font-size: 14px;
        }

        .inventory-price {
            color: #4caf50;
            font-weight: bold;
        }

        .item-consumer { color: #b0c3d9; }
        .item-industrial { color: #5e98d9; }
        .item-milspec { color: #4b69ff; }
        .item-restricted { color: #8847ff; }
        .item-classified { color: #d32ee6; }
        .item-covert { color: #eb4b4b; }
        .item-knife { color: #ffd700; }

        /* Апгрейд зона */
        .upgrade-container {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 30px;
            margin-top: 30px;
        }

        .upgrade-slot {
            background: rgba(0, 0, 0, 0.5);
            border-radius: 20px;
            padding: 30px;
            text-align: center;
            border: 2px dashed #ffd700;
            min-height: 200px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }

        .upgrade-slot.filled {
            border-style: solid;
            background: rgba(255, 215, 0, 0.1);
        }

        .upgrade-slot .remove-item {
            margin-top: 10px;
            background: rgba(255, 0, 0, 0.5);
            border: none;
            color: white;
            padding: 5px 15px;
            border-radius: 15px;
            cursor: pointer;
        }

        .upgrade-btn {
            grid-column: span 3;
            background: linear-gradient(135deg, #ffd700, #ffa500);
            border: none;
            color: #1a1f2f;
            padding: 20px;
            font-size: 24px;
            font-weight: bold;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .upgrade-btn:hover:not(:disabled) {
            transform: scale(1.02);
            box-shadow: 0 0 30px rgba(255, 215, 0, 0.5);
        }

        .upgrade-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .upgrade-chance {
            text-align: center;
            font-size: 18px;
            margin-top: 20px;
            color: #ffd700;
        }

        /* Битва */
        .battle-area {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-top: 30px;
        }

        .player-side, .enemy-side {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            padding: 20px;
        }

        .side-title {
            text-align: center;
            font-size: 24px;
            margin-bottom: 20px;
            color: #ffd700;
        }

        .battle-items {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 20px;
        }

        .battle-slot {
            background: rgba(0, 0, 0, 0.5);
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            border: 2px solid #333;
            min-height: 100px;
            cursor: pointer;
        }

        .battle-slot.filled {
            border-color: #ffd700;
        }

        .battle-total {
            text-align: center;
            font-size: 20px;
            padding: 15px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 10px;
        }

        .battle-btn {
            grid-column: span 2;
            background: linear-gradient(135deg, #ff4b4b, #d32f2f);
            border: none;
            color: white;
            padding: 20px;
            font-size: 24px;
            font-weight: bold;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 20px;
        }

        .battle-btn:hover:not(:disabled) {
            transform: scale(1.02);
            box-shadow: 0 0 30px rgba(255, 75, 75, 0.5);
        }

        .battle-result {
            text-align: center;
            font-size: 28px;
            margin-top: 20px;
            padding: 20px;
            border-radius: 20px;
            animation: resultAppear 0.5s ease;
        }

        .battle-result.win {
            background: rgba(76, 175, 80, 0.3);
            color: #4caf50;
        }

        .battle-result.lose {
            background: rgba(244, 67, 54, 0.3);
            color: #f44336;
        }

        /* Кнопки управления */
        .action-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin: 20px 0;
        }

        .action-btn {
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: white;
            padding: 15px 40px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 18px;
            transition: all 0.3s;
            border: 1px solid transparent;
        }

        .action-btn.primary {
            background: #4caf50;
            color: white;
        }

        .action-btn.primary:hover:not(:disabled) {
            background: #45a049;
            transform: translateY(-2px);
        }

        .action-btn.secondary {
            background: #ff4b4b;
        }

        .action-btn.secondary:hover {
            background: #d32f2f;
            transform: translateY(-2px);
        }

        .reset-btn {
            background: #ffd700;
            color: #1a1f2f;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <!-- Навигация -->
    <div class="navbar">
        <div class="logo">🎮 CS:BATTLE SIMULATOR</div>
        <div class="balance">
            Баланс: <span id="balanceAmount">10000</span> 💰
        </div>
        <div class="nav-buttons">
            <button class="nav-btn active" onclick="switchPage('cases')">Кейсы</button>
            <button class="nav-btn" onclick="switchPage('upgrade')">Апгрейд</button>
            <button class="nav-btn" onclick="switchPage('battle')">Битва</button>
        </div>
    </div>

    <div class="container">
        <!-- Страница с кейсами -->
        <div id="cases-page" class="page active-page">
            <h1 style="text-align: center; margin-bottom: 30px;">🔥 Открытие кейсов</h1>
            
            <div class="cases-grid" id="casesGrid"></div>

            <div class="result-area" id="resultArea">
                <p>Выбери кейс и начни открывать!</p>
            </div>

            <div class="action-buttons">
                <button class="action-btn primary" id="openCaseBtn" onclick="openCase()">🔓 Открыть выбранный кейс</button>
                <button class="action-btn reset-btn" onclick="resetGame()">🔄 Сбросить всё</button>
            </div>
        </div>

        <!-- Страница апгрейда -->
        <div id="upgrade-page" class="page">
            <h1 style="text-align: center; margin-bottom: 30px;">⬆️ Апгрейд предметов</h1>
            
            <div class="inventory-grid" id="inventoryGrid"></div>

            <div class="upgrade-container" id="upgradeContainer">
                <div class="upgrade-slot" id="upgradeSlot1" onclick="selectUpgradeSlot(1)">
                    <div class="slot-content">
                        <span class="slot-placeholder">Выбери предмет 1</span>
                    </div>
                </div>
                <div class="upgrade-slot" id="upgradeSlot2" onclick="selectUpgradeSlot(2)">
                    <div class="slot-content">
                        <span class="slot-placeholder">Выбери предмет 2</span>
                    </div>
                </div>
                <div class="upgrade-slot" id="upgradeSlot3" onclick="selectUpgradeSlot(3)">
                    <div class="slot-content">
                        <span class="slot-placeholder">Выбери предмет 3</span>
                    </div>
                </div>
                <button class="upgrade-btn" id="upgradeBtn" onclick="performUpgrade()" disabled>Сделать апгрейд (40% шанс)</button>
            </div>

            <div class="upgrade-chance" id="upgradeChance"></div>
        </div>

        <!-- Страница битвы -->
        <div id="battle-page" class="page">
            <h1 style="text-align: center; margin-bottom: 30px;">⚔️ Битва кейсов</h1>
            
            <div class="battle-area">
                <div class="player-side">
                    <div class="side-title">ТВОИ ПРЕДМЕТЫ</div>
                    <div class="battle-items" id="playerBattleItems">
                        <div class="battle-slot" id="playerSlot1" onclick="selectPlayerBattleSlot(1)">Выбери предмет</div>
                        <div class="battle-slot" id="playerSlot2" onclick="selectPlayerBattleSlot(2)">Выбери предмет</div>
                        <div class="battle-slot" id="playerSlot3" onclick="selectPlayerBattleSlot(3)">Выбери предмет</div>
                        <div class="battle-slot" id="playerSlot4" onclick="selectPlayerBattleSlot(4)">Выбери предмет</div>
                    </div>
                    <div class="battle-total" id="playerTotal">Общая стоимость: 0💰</div>
                </div>
                
                <div class="enemy-side">
                    <div class="side-title">ПРЕДМЕТЫ ВРАГА</div>
                    <div class="battle-items" id="enemyBattleItems">
                        <div class="battle-slot" id="enemySlot1">???</div>
                        <div class="battle-slot" id="enemySlot2">???</div>
                        <div class="battle-slot" id="enemySlot3">???</div>
                        <div class="battle-slot" id="enemySlot4">???</div>
                    </div>
                    <div class="battle-total" id="enemyTotal">Общая стоимость: 0💰</div>
                </div>
            </div>

            <button class="battle-btn" id="battleBtn" onclick="startBattle()" disabled>Начать битву (ставка 500💰)</button>
            <div class="battle-result" id="battleResult"></div>
        </div>
    </div>

    <script>
        // Класс предмета
        class Item {
            constructor(name, rarity, color, price, icon = '🔫') {
                this.id = Date.now() + Math.random();
                this.name = name;
                this.rarity = rarity;
                this.color = color;
                this.price = price;
                this.icon = icon;
            }
        }

        // База предметов
        const itemsDatabase = [
            // Базовое
            new Item("MAC-10 | Palm", "consumer", "#b0c3d9", 5, '🔫'),
            new Item("MP9 | Palm", "consumer", "#b0c3d9", 4, '🔫'),
            new Item("FAMAS | Cyanospatter", "consumer", "#b0c3d9", 6, '🔫'),
            
            // Промышленное
            new Item("M4A4 | Jungle Tiger", "industrial", "#5e98d9", 15, '🔫'),
            new Item("AK-47 | Safari Mesh", "industrial", "#5e98d9", 18, '🔫'),
            
            // Армейское
            new Item("AWP | Worm God", "milspec", "#4b69ff", 40, '🔫'),
            new Item("M4A1-S | Boreal Forest", "milspec", "#4b69ff", 35, '🔫'),
            
            // Запрещенное
            new Item("Desert Eagle | Cobalt Disruption", "restricted", "#8847ff", 80, '🔫'),
            new Item("AK-47 | Cartel", "restricted", "#8847ff", 95, '🔫'),
            
            // Тайное
            new Item("M4A4 | Asiimov", "classified", "#d32ee6", 200, '🔫'),
            new Item("AWP | Hyper Beast", "classified", "#d32ee6", 250, '🔫'),
            
            // Особое
            new Item("AWP | Dragon Lore", "covert", "#eb4b4b", 1000, '🔫'),
            new Item("M4A1-S | Knight", "covert", "#eb4b4b", 800, '🔫'),
            
            // Ножи
            new Item("Karambit | Fade", "knife", "#ffd700", 5000, '🔪'),
            new Item("M9 Bayonet | Doppler", "knife", "#ffd700", 4500, '🔪'),
            new Item("Butterfly Knife | Fade", "knife", "#ffd700", 5500, '🔪'),
            new Item("Bayonet | Tiger Tooth", "knife", "#ffd700", 4800, '🔪')
        ];

        // Кейсы
        const cases = [
            {
                name: "Оружейный кейс",
                icon: "📦",
                price: 100,
                items: itemsDatabase.slice(0, 8)
            },
            {
                name: "Кейс с ножами",
                icon: "🗡️",
                price: 500,
                items: itemsDatabase.filter(item => item.rarity === 'knife' || item.price > 200)
            },
            {
                name: "Премиум кейс",
                icon: "💎",
                price: 1000,
                items: itemsDatabase.filter(item => item.price > 100)
            },
            {
                name: "Удачный кейс",
                icon: "🍀",
                price: 250,
                items: itemsDatabase
            }
        ];

        // Состояние игры
        let balance = 10000;
        let inventory = [];
        let selectedCase = 0;
        let currentUpgradeSlot = null;
        let upgradeSlots = [null, null, null];
        let playerBattleSlots = [null, null, null, null];
        let selectedBattleSlot = null;

        // DOM элементы
        const balanceElement = document.getElementById('balanceAmount');
        const casesGrid = document.getElementById('casesGrid');
        const resultArea = document.getElementById('resultArea');
        const inventoryGrid = document.getElementById('inventoryGrid');
        const upgradeBtn = document.getElementById('upgradeBtn');
        const upgradeChance = document.getElementById('upgradeChance');
        const battleBtn = document.getElementById('battleBtn');
        const playerTotalElement = document.getElementById('playerTotal');
        const enemyTotalElement = document.getElementById('enemyTotal');
        const battleResult = document.getElementById('battleResult');

        // Переключение страниц
        function switchPage(pageName) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active-page'));
            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
            
            document.getElementById(`${pageName}-page`).classList.add('active-page');
            event.target.classList.add('active');
            
            if (pageName === 'upgrade') renderInventory();
            if (pageName === 'battle') renderBattle();
        }

        // Инициализация кейсов
        function renderCases() {
            casesGrid.innerHTML = '';
            cases.forEach((caseItem, index) => {
                const card = document.createElement('div');
                card.className = `case-card ${index === selectedCase ? 'selected' : ''}`;
                card.onclick = () => selectCase(index);
                card.innerHTML = `
                    <div class="case-icon">${caseItem.icon}</div>
                    <div class="case-name">${caseItem.name}</div>
                    <div class="case-price">${caseItem.price} 💰</div>
                    <div class="case-items">${caseItem.items.length} предметов</div>
                `;
                casesGrid.appendChild(card);
            });
        }

        function selectCase(index) {
            selectedCase = index;
            renderCases();
        }

        // Получение случайного предмета из кейса
        function getRandomItemFromCase(caseIndex) {
            const caseData = cases[caseIndex];
            const random = Math.random() * 100;
            
            if (caseIndex === 1) { // Кейс с ножами
                if (random < 20) { // 20% шанс на нож
                    const knives = caseData.items.filter(i => i.rarity === 'knife');
                    return knives[Math.floor(Math.random() * knives.length)];
                }
            }
            
            // Обычное распределение
            if (random < 2) { // 2% - особое
                const rare = caseData.items.filter(i => i.price > 500);
                return rare[Math.floor(Math.random() * rare.length)] || caseData.items[0];
            } else if (random < 10) { // 8% - тайное
                const rare = caseData.items.filter(i => i.price > 200 && i.price < 500);
                return rare[Math.floor(Math.random() * rare.length)] || caseData.items[0];
            } else if (random < 30) { // 20% - запрещенное
                const rare = caseData.items.filter(i => i.price > 50 && i.price < 200);
                return rare[Math.floor(Math.random() * rare.length)] || caseData.items[0];
            } else {
                return caseData.items[Math.floor(Math.random() * caseData.items.length)];
            }
        }

        // Открытие кейса
        function openCase() {
            const caseData = cases[selectedCase];
            
            if (balance < caseData.price) {
                alert('Недостаточно средств!');
                return;
            }

            balance -= caseData.price;
            const wonItem = getRandomItemFromCase(selectedCase);
            const newItem = new Item(
                wonItem.name,
                wonItem.rarity,
                wonItem.color,
                wonItem.price,
                wonItem.icon
            );
            
            inventory.push(newItem);
            
            resultArea.innerHTML = `
                <div class="item-display">
                    <div class="item-name" style="color: ${newItem.color}">${newItem.icon} ${newItem.name}</div>
                    <div class="item-price">💰 +${newItem.price}</div>
                    <div class="item-quality">${newItem.rarity}</div>
                </div>
            `;
            
            updateBalance();
            renderInventory();
        }

        // Рендер инвентаря
        function renderInventory() {
            inventoryGrid.innerHTML = '';
            
            if (inventory.length === 0) {
                inventoryGrid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: #888;">Инвентарь пуст. Открой кейсы!</p>';
                return;
            }
            
            inventory.forEach((item, index) => {
                const itemDiv = document.createElement('div');
                itemDiv.className = `inventory-item item-${item.rarity}`;
                itemDiv.onclick = () => selectInventoryItem(index);
                itemDiv.innerHTML = `
                    <div class="inventory-icon">${item.icon}</div>
                    <div class="inventory-name" style="color: ${item.color}">${item.name}</div>
                    <div class="inventory-price">${item.price}💰</div>
                `;
                inventoryGrid.appendChild(itemDiv);
            });
        }

        // Выбор предмета из инвентаря
        function selectInventoryItem(index) {
            if (currentUpgradeSlot !== null) {
                // Режим апгрейда
                upgradeSlots[currentUpgradeSlot - 1] = inventory[index];
                inventory.splice(index, 1);
                renderUpgradeSlots();
                renderInventory();
                currentUpgradeSlot = null;
                updateUpgradeButton();
            } else if (selectedBattleSlot !== null) {
                // Режим битвы
                playerBattleSlots[selectedBattleSlot - 1] = inventory[index];
                inventory.splice(index, 1);
                renderBattleSlots();
                renderInventory();
                selectedBattleSlot = null;
                updateBattleButton();
            }
        }

        // Апгрейд слоты
        function selectUpgradeSlot(slotNumber) {
            currentUpgradeSlot = slotNumber;
            alert(`Выбери предмет для слота ${slotNumber} в инвентаре`);
        }

        function renderUpgradeSlots() {
            for (let i = 0; i < 3; i++) {
                const slot = document.getElementById(`upgradeSlot${i + 1}`);
                const item = upgradeSlots[i];
                
                if (item) {
                    slot.classList.add('filled');
                    slot.innerHTML = `
                        <div class="slot-content">
                            <div style="color: ${item.color}">${item.icon} ${item.name}</div>
                            <div>${item.price}💰</div>
                            <button class="remove-item" onclick="removeFromUpgrade(${i})">❌</button>
                        </div>
                    `;
                } else {
                    slot.classList.remove('filled');
                    slot.innerHTML = `
                        <div class="slot-content">
                            <span class="slot-placeholder">Выбери предмет ${i + 1}</span>
                        </div>
                    `;
                }
            }
        }

        function removeFromUpgrade(slotIndex) {
            if (upgradeSlots[slotIndex]) {
                inventory.push(upgradeSlots[slotIndex]);
                upgradeSlots[slotIndex] = null;
                renderUpgradeSlots();
                renderInventory();
                updateUpgradeButton();
            }
        }

        function updateUpgradeButton() {
            const filledSlots = upgradeSlots.filter(s => s !== null).length;
            if (filledSlots === 3) {
                upgradeBtn.disabled = false;
                upgradeChance.textContent = 'Шанс успеха: 40%';
            } else {
                upgradeBtn.disabled = true;
                upgradeChance.textContent = `Нужно еще ${3 - filledSlots} предмета`;
            }
        }

        function performUpgrade() {
            if (upgradeSlots.some(s => s === null)) return;
            
            const totalPrice = upgradeSlots.reduce((sum, item) => sum + item.price, 0);
            const success = Math.random() < 0.4; // 40% шанс
            
            if (success) {
                // Успешный апгрейд - создаем предмет лучше
                const rarities = ['consumer', 'industrial', 'milspec', 'restricted', 'classified', 'covert', 'knife'];
                const maxRarity = Math.max(...upgradeSlots.map(i => rarities.indexOf(i.rarity)));
                const newRarity = rarities[Math.min(maxRarity + 1, rarities.length - 1)];
                
                const possibleItems = itemsDatabase.filter(i => i.rarity === newRarity);
                const newItem = new Item(
                    possibleItems[Math.floor(Math.random() * possibleItems.length)].name,
                    newRarity,
                    possibleItems[0].color,
                    totalPrice * 1.5,
                    '✨'
                );
                
                inventory.push(newItem);
                resultArea.innerHTML = `
                    <div class="item-display">
                        <div style="color: #4caf50; font-size: 24px;">✅ АПГРЕЙД УСПЕШЕН!</div>
                        <div class="item-name" style="color: ${newItem.color}">✨ ${newItem.name}</div>
                        <div class="item-price">💰 +${Math.round(newItem.price)}</div>
                    </div>
                `;
            } else {
                // Неудача - теряем предметы
                resultArea.innerHTML = `
                    <div class="item-display">
                        <div style="color: #f44336; font-size: 24px;">❌ АПГРЕЙД НЕ УДАЛСЯ</div>
                        <div>Предметы сгорели...</div>
                    </div>
                `;
            }
            
            upgradeSlots = [null, null, null];
            renderUpgradeSlots();
            renderInventory();
            updateUpgradeButton();
        }

        // Битва
        function selectPlayerBattleSlot(slotNumber) {
            selectedBattleSlot = slotNumber;
            alert(`Выбери предмет для слота ${slotNumber} в инвентаре`);
        }

        function renderBattleSlots() {
            // Слоты игрока
            for (let i = 0; i < 4; i++) {
                const slot = document.getElementById(`playerSlot${i + 1}`);
                const item = playerBattleSlots[i];
                
                if (item) {
                    slot.classList.add('filled');
                    slot.innerHTML = `
                        <div style="color: ${item.color}">${item.icon}</div>
                        <div style="color: ${item.color}; font-size: 12px;">${item.name.slice(0, 10)}...</div>
                        <div>${item.price}💰</div>
                    `;
                } else {
                    slot.classList.remove('filled');
                    slot.innerHTML = 'Выбери предмет';
                }
            }
            
            // Обновляем общую стоимость
            const playerTotal = playerBattleSlots.reduce((sum, item) => sum + (item?.price || 0), 0);
            playerTotalElement.textContent = `Общая стоимость: ${playerTotal}💰`;
        }

        function generateEnemyItems() {
            const enemyItems = [];
            for (let i = 0; i < 4; i++) {
                const randomItem = itemsDatabase[Math.floor(Math.random() * itemsDatabase.length)];
                enemyItems.push(new Item(
                    randomItem.name,
                    randomItem.rarity,
                    randomItem.color,
                    randomItem.price,
                    randomItem.icon
                ));
            }
            return enemyItems;
        }

        function renderEnemyItems(items) {
            for (let i = 0; i < 4; i++) {
                const slot = document.getElementById(`enemySlot${i + 1}`);
                const item = items[i];
                
                if (item) {
                    slot.classList.add('filled');
                    slot.innerHTML = `
                        <div style="color: ${item.color}">${item.icon}</div>
                        <div style="color: ${item.color}; font-size: 12px;">${item.name.slice(0, 10)}...</div>
                        <div>${item.price}💰</div>
                    `;
                }
            }
            
            const enemyTotal = items.reduce((sum, item) => sum + item.price, 0);
            enemyTotalElement.textContent = `Общая стоимость: ${enemyTotal}💰`;
        }

        function updateBattleButton() {
            const filledSlots = playerBattleSlots.filter(s => s !== null).length;
            battleBtn.disabled = filledSlots !== 4 || balance < 500;
            
            if (balance < 500) {
                battleBtn.textContent = 'Недостаточно средств для ставки';
            } else if (filledSlots !== 4) {
                battleBtn.textContent = `Нужно еще ${4 - filledSlots} предмета`;
            } else {
                battleBtn.textContent = 'Начать битву (ставка 500💰)';
            }
        }

        function startBattle() {
            if (playerBattleSlots.some(s => s === null) || balance < 500) return;
            
            balance -= 500;
            
            const enemyItems = generateEnemyItems();
            renderEnemyItems(enemyItems);
            
            const playerTotal = playerBattleSlots.reduce((sum, item) => sum + item.price, 0);
            const enemyTotal = enemyItems.reduce((sum, item) => sum + item.price, 0);
            
            let result, prize;
            
            if (playerTotal > enemyTotal) {
                // Победа
                prize = Math.round((playerTotal + enemyTotal) * 1.5);
                balance += prize;
                result = {
                    text: `🏆 ПОБЕДА! +${prize}💰`,
                    class: 'win'
                };
                
                // Возвращаем предметы
                inventory.push(...playerBattleSlots);
            } else if (playerTotal < enemyTotal) {
                // Поражение
                prize = 0;
                result = {
                    text: `💔 ПОРАЖЕНИЕ... Предметы потеряны`,
                    class: 'lose'
                };
                // Предметы не возвращаются
            } else {
                // Ничья
                prize = playerTotal;
                balance += prize;
                inventory.push(...playerBattleSlots);
                result = {
                    text: `🤝 НИЧЬЯ! Возврат ${prize}💰`,
                    class: 'win'
                };
            }
            
            battleResult.innerHTML = `
                <div class="battle-result ${result.class}">
                    ${result.text}
                </div>
            `;
            
            playerBattleSlots = [null, null, null, null];
            renderBattleSlots();
            updateBalance();
            updateBattleButton();
            renderInventory();
            
            setTimeout(() => {
                battleResult.innerHTML = '';
            }, 3000);
        }

        function renderBattle() {
            renderBattleSlots();
            updateBattleButton();
        }

        // Обновление баланса
        function updateBalance() {
            balanceElement.textContent = balance;
        }

        // Сброс игры
        function resetGame() {
            balance = 10000;
            inventory = [];
            upgradeSlots = [null, null, null];
            playerBattleSlots = [null, null, null, null];
            
            updateBalance();
            renderInventory();
            renderUpgradeSlots();
            renderBattleSlots();
            resultArea.innerHTML = '<p>Выбери кейс и начни открывать!</p>';
            
            alert('Игра сброшена! Баланс: 10000💰');
        }

        // Инициализация
        renderCases();
        updateBalance();
    </script>
</body>
</html>
